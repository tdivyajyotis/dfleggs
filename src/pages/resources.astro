---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro';
const resources=[['Guide','Receiving DFLs: what to check first','A practical receiving checklist to publish once the approved handling process is confirmed.'],['Advisory','Planning for the next rearing cycle','A placeholder for seasonal guidance, local availability notes and timely preparation tips.'],['Explainer','What are Disease-Free Layings?','A plain-English resource explaining how DFLs fit into sericulture and why early quality matters.'],['FAQ','Questions about DFL supply','A home for verified answers about orders, handling, product availability and local support.'],['Download','Product sheet','Upload approved product sheets, packaging information and quality documentation here.'],['Update','News from DFL Eggs','Use this space for meaningful product, process and local-support updates.']];
---
<BaseLayout title="Resources | DFL Eggs"><Header /><main><section class="page-hero mint"><div class="wrap narrow"><p class="eyebrow">Resources</p><h1>Useful guidance between <em>rearing cycles.</em></h1><p>Clear, practical information for farmers and distributors. Publish verified guides, seasonal advisories and product documentation here as they become available.</p></div></section><section class="section"><div class="wrap resource-grid">{resources.map(([type,title,copy])=><article><p class="mono">{type.toUpperCase()}</p><h2>{title}</h2><p>{copy}</p><a class="text-link" href="/contact/">Coming soon <span>→</span></a></article>)}</div></section><section class="section soft-panel"><div class="wrap two-col"><div><p class="eyebrow">Need an answer sooner?</p><h2>Ask the team directly.</h2></div><div><p>For product-specific questions, availability or handling guidance, reach out with your location and requirement. The team can help direct you to the relevant local supply channel.</p><a class="button" href="/contact/#enquiry">Contact DFL Eggs <span>→</span></a></div></div></section></main><Footer /></BaseLayout>
