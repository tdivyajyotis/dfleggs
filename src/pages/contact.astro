---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro';
---
<BaseLayout title="Contact DFL Eggs"><Header /><main><section class="page-hero blue"><div class="wrap narrow"><p class="eyebrow">Contact</p><h1>Let’s plan your next <em>rearing cycle.</em></h1><p>Whether you are a farmer, distributor or institution, tell us what you need and we’ll direct your enquiry through the relevant channel.</p></div></section><section id="enquiry" class="section contact-section"><div class="wrap contact-grid"><div><p class="eyebrow">Enquire now</p><h2>Start with a few details.</h2><p>Fields marked with an asterisk are required. Your information should be handled according to the published privacy policy.</p><div class="contact-options"><a href="tel:+910000000000"><b>Call us</b><span>+91 00000 00000</span></a><a href="https://wa.me/910000000000" target="_blank" rel="noreferrer"><b>WhatsApp</b><span>Send a message ↗</span></a><a href="mailto:hello@dfleggs.example"><b>Email</b><span>hello@dfleggs.example</span></a></div><p class="placeholder-note">Replace all placeholder contact details and connect this form to your approved enquiry recipient before launch.</p></div><form class="enquiry-form" data-enquiry-form><div class="form-row"><label>I'm enquiring as*<select required name="type"><option value="">Select one</option><option>Farmer</option><option>Distributor</option><option>Institution</option><option>Other</option></select></label><label>Name*<input required name="name" autocomplete="name" /></label></div><div class="form-row"><label>Phone*<input required name="phone" inputmode="tel" autocomplete="tel" /></label><label>District*<input required name="district" /></label></div><div class="form-row"><label>State*<input required name="state" /></label><label>Requirement<input name="requirement" placeholder="e.g. product, quantity or partnership" /></label></div><label>Message<textarea name="message" rows="5" placeholder="Tell us a little about what you need."></textarea></label><button class="button" type="submit">Send enquiry <span>→</span></button><p class="form-status" aria-live="polite"></p></form></div></section></main><Footer /><script>document.querySelector('[data-enquiry-form]')?.addEventListener('submit', (event) => { event.preventDefault(); event.currentTarget.querySelector('.form-status').textContent = 'Thank you. This demo form is ready to connect to your approved enquiry system.'; });</script></BaseLayout>
