---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import Icons from '../components/Icons.astro'; import hero from '../assets/sericulture-hero.png';
const benefits = [['quality','Quality-first DFLs','Designed to support healthy silkworm rearing.'],['technology','Technology-backed process','Advanced systems help reduce dependence on seasonal, untrained manual processes.'],['access','Built for access','Dependable DFL supply at a farmer-conscious price.']];
---
<BaseLayout>
  <Header />
  <main>
    <section class="hero"><div class="hero-image" style={`--hero-image: url(${hero.src})`} role="img" aria-label="Sericulture farmer inspecting trays in a mulberry rearing house"></div><div class="wrap hero-content"><p class="eyebrow light-eyebrow">A SERISCOPE PVT. LTD. BRAND</p><h1>Reliable DFLs for<br /><em>stronger sericulture.</em></h1><p class="hero-copy">Technology-backed Disease-Free Layings for farmers and distributors—supplied with quality, consistency, and accessibility in mind.</p><div class="button-group"><a class="button" href="/contact/#enquiry">Enquire now <span>→</span></a><a class="button button-ghost" href="/for-distributors/">Become a distributor</a></div><p class="hero-trust"><span class="dot"></span> A Seriscope Pvt. Ltd. brand</p></div><div class="hero-orb" aria-hidden="true"></div></section>
    <section class="section intro"><div class="wrap split-intro"><div><p class="eyebrow">A dependable starting point</p><h2>Healthy beginnings begin <em>before rearing.</em></h2></div><div><p>DFL Eggs helps farmers and distributors access Disease-Free Layings with a focus on careful processes, dependable supply and practical support. Our approach puts better preparation behind every rearing cycle.</p><a class="text-link" href="/about/">Meet DFL Eggs <span>→</span></a></div></div></section>
    <section class="section benefits"><div class="wrap"><div class="section-heading"><p class="eyebrow">Why DFL Eggs</p><h2>Built around what a strong <em>start requires.</em></h2></div><div class="card-grid">{benefits.map(([icon,title,text], index) => <article class="benefit-card"><span class="card-num">0{index + 1}</span><Icons name={icon}/><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
    <section class="section precision"><div class="wrap precision-grid"><div class="precision-art"><div class="scan"><span></span><span></span><span></span><span></span><span></span></div><div class="egg-form"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><p>PROCESS CONTROL<br/>WITH A HUMAN VIEW</p></div><div><p class="eyebrow">Technology & quality</p><h2>Precision behind<br />every <em>DFL.</em></h2><p>Technology supports consistent inspection and handling at key stages. It helps make the process more measurable and less dependent on seasonal, untrained manual work—while expert oversight remains essential.</p><div class="proof-note"><strong>98.6%</strong><span><b>Accuracy figure pending substantiation.</b> Publish this only after defining the exact measurement, test conditions, sample size and evidence source.</span></div><a class="text-link" href="/technology-quality/">Explore our technology <span>→</span></a></div></div></section>
    <section class="section pathways"><div class="wrap"><div class="section-heading centered"><p class="eyebrow">Choose your pathway</p><h2>Made for the people who <em>keep sericulture moving.</em></h2></div><div class="path-grid"><article class="path-card farmer"><p class="eyebrow">For farmers</p><h3>Plan each rearing cycle with greater confidence.</h3><ul><li>Clear availability enquiries</li><li>Practical handling guidance</li><li>Support when you need it</li></ul><a class="button button-white" href="/for-farmers/">For farmers <span>→</span></a></article><article class="path-card distributor"><p class="eyebrow">For distributors</p><h3>A dependable partner for your local network.</h3><ul><li>Quality-focused supply process</li><li>Simple enquiry and coordination</li><li>Local support-led relationships</li></ul><a class="button" href="/for-distributors/">Become a distributor <span>→</span></a></article></div></div></section>
    <section class="section how"><div class="wrap"><div class="section-heading"><p class="eyebrow">How it works</p><h2>From enquiry to <em>rearing.</em></h2></div><ol class="steps"><li><b>01</b><h3>Enquire</h3><p>Tell us what you need and where you are located.</p></li><li><b>02</b><h3>Confirm</h3><p>We confirm availability and the relevant requirements.</p></li><li><b>03</b><h3>Receive</h3><p>DFLs are supplied through the relevant supply channel.</p></li><li><b>04</b><h3>Begin</h3><p>Start rearing with support available when required.</p></li></ol></div></section>
    <section class="cta-band"><div class="wrap cta-inner"><div><p class="eyebrow light-eyebrow">Start a conversation</p><h2>Ready to plan your next <em>rearing cycle?</em></h2></div><div><a class="button button-white" href="/contact/#enquiry">Enquire now <span>→</span></a><p><a href="https://wa.me/910000000000" target="_blank" rel="noreferrer">Or message us on WhatsApp ↗</a></p></div></div></section>
  </main><Footer />
</BaseLayout>
