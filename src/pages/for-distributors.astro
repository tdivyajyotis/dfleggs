---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import Icons from '../components/Icons.astro';
---
<BaseLayout title="For Distributors | DFL Eggs"><Header /><main><section class="page-hero distributor-hero"><div class="wrap narrow"><p class="eyebrow">For distributors</p><h1>A more dependable way to serve your <em>local network.</em></h1><p>Partner with DFL Eggs to explore a quality-focused DFL supply relationship built on clear coordination and practical support.</p><a class="button" href="/contact/#enquiry">Apply to distribute <span>→</span></a></div></section><section class="section"><div class="wrap split-intro"><div><p class="eyebrow">Why partner</p><h2>Strengthen the local link between DFL supply and <em>rearing.</em></h2></div><div><p>Distributors can help farmers access a reliable product through a local, responsive supply channel. DFL Eggs aims to support these relationships with better process consistency and simple communication.</p></div></div></section><section class="section"><div class="wrap info-cards three"><article><Icons name="delivery"/><h3>Supply coordination</h3><p>Discuss availability, delivery pathways and your local coverage.</p></article><article><Icons name="quality"/><h3>Quality conversations</h3><p>Share the right product and process information with your network.</p></article><article><Icons name="support"/><h3>Ongoing support</h3><p>Build a practical working relationship around farmer needs.</p></article></div></section><section class="section proof"><div class="wrap proof-grid"><div><p class="eyebrow">Before you apply</p><h2>Start with the details that make a partnership <em>work.</em></h2><p>Tell us about your territory, existing customer base, local experience and the support you need. Territory terms, ordering flow, payment and minimum quantities should be agreed directly with the DFL Eggs team.</p></div><aside><p class="mono">DISTRIBUTOR ENQUIRY</p><h3>What to include</h3><ul class="check-list"><li>District and state</li><li>Areas you currently serve</li><li>Sericulture market experience</li><li>Your expected requirement</li></ul></aside></div></section><section class="cta-band"><div class="wrap cta-inner"><div><p class="eyebrow light-eyebrow">Become a partner</p><h2>Let’s discuss your territory.</h2></div><a class="button button-white" href="/contact/#enquiry">Apply to distribute <span>→</span></a></div></section></main><Footer /></BaseLayout>
