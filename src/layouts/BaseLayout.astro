---
import '../styles/global.css';
import '../styles/hero.css';
const { title = 'DFL Eggs | Reliable DFLs. Stronger Sericulture.', description = 'Technology-backed Disease-Free Layings for sericulture farmers and distributors.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=Inter:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script define:vars={{ base: import.meta.env.BASE_URL }}>
      document.querySelectorAll('a[href^="/"]').forEach((link) => {
        const href = link.getAttribute('href');
        if (href && !href.startsWith('//')) link.setAttribute('href', `${base}${href.slice(1)}`);
      });
    </script>
  </body>
</html>
