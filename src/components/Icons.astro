  quality: '<path d="M12 3 20 6v6c0 5-3.3 8.2-8 9-4.7-.8-8-4-8-9V6l8-3Z"/><path d="m8.5 12 2.2 2.2 4.7-4.7"/>',
  technology: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 3v4M12 3v4M16 3v4M8 17v4M12 17v4M16 17v4M3 8h4M3 12h4M3 16h4M17 8h4M17 12h4M17 16h4"/><rect x="8" y="8" width="8" height="8" rx="1"/>',
  access: '<path d="M4 20v-9l8-6 8 6v9"/><path d="M9 20v-5h6v5M3 20h18"/>',
  support: '<path d="M5 12v-1a7 7 0 0 1 14 0v1"/><path d="M5 12H3v4h3M19 12h2v4h-3M18 20c-1.3.7-2.7 1-4 1"/>',
